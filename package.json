{
  "name": "@dedcinema/contracts",
  "version": "1.0.1",
  "description": "Protobuf definition and generated TypeScript types",
  "scripts": {
    "generate": "protoc -I ./proto ./proto/*.proto --plugin=protoc-gen-ts_proto=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit"
  },
  "files": [
    "proto",
    "gen"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@nestjs/microservices": "^11.1.17",
    "rxjs": "^7.8.2",
    "ts-proto": "^2.11.5"
  }
}
